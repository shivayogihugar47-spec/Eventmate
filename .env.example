# OpenRouter (LLM)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=

# Google Maps Platform (enable Places API (New); keep this key server-side)
GOOGLE_MAPS_API_KEY=

# Neon Postgres (filled automatically by `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon branch context
NEON_BRANCH=

# Neon Auth (filled automatically by `neon deploy`)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Neon Functions (filled automatically by `neon deploy`)
NEON_FUNCTION_HELLO_BASE_URL=
